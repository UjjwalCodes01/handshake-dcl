{
  "name": "handshake-dcl",
  "version": "0.1.0",
  "description": "Handshake \u2014 a mobile-first social multiplayer Decentraland SDK7 scene",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "sdk-commands start",
    "build": "sdk-commands build",
    "deploy": "sdk-commands deploy",
    "typecheck": "tsc --noEmit",
    "upgrade-sdk": "npm install --save-exact --save-dev @dcl/sdk@auth-server @dcl/js-runtime@auth-server",
    "server-logs": "sdk-commands sdk-server-logs",
    "start:web": "sdk-commands start --web",
    "start:mobile": "sdk-commands start --mobile",
    "start:multi": "sdk-commands start --web --multi-instance",
    "test": "node --test \"test/*.test.ts\"",
    "build:prod": "sdk-commands build --production",
    "preflight": "npm run build:prod && node tools/preflight.mjs"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.1-32239895147.commit-3c77d90",
    "@dcl/sdk": "7.26.1-32239895147.commit-3c77d90"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
